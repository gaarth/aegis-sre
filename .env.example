# ============================================================
# .env.example — Sentinel Governor (SG-1)
# Copy to .env.local and populate all values before running.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_PROJECT_REF=<project-ref>

# ── Groq ─────────────────────────────────────────────────────
# Found in: https://console.groq.com/keys
GROQ_API_KEY=gsk_<your-groq-api-key>

# ── Webhook Security ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=<hex-secret>

# ── Tool Registry ────────────────────────────────────────────
# All tools run as dry-run stubs (no real infrastructure calls)
TOOL_DRY_RUN=true

# ── Embeddings (for incident_memory pgvector) ─────────────────
# Set to true to use deterministic hash stubs instead of real embeddings
USE_EMBEDDING_STUB=true

# ── Prometheus (optional) ────────────────────────────────────
# PROMETHEUS_URL=http://localhost:9090
